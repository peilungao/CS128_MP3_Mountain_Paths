{
  "files.eol": "\n",
  "clang-format.fallbackStyle": "Google",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "xaver.clang-format",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "clang-tidy.lintOnSave": true,
  "clang-tidy.blacklist": [],
  "clang-tidy.compilerArgs": ["-std=c++20"],
  "clang-tidy.compilerArgsBefore": [
    "-Iincludes",
    "-Wunused-variable",
    "-Wuninitialized",
    "-Wunused-value"
  ],
  "C_Cpp.clang_format_sortIncludes": false,
  "C_Cpp.vcFormat": "Disabled",
  "C_Cpp.inactiveRegionOpacity": 0.1,
  "github.copilot.enable": {
    "*": false
  },
  "chat.disableAIFeatures": true,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "*.m4a": "external",
    "*.mp3": "external",
    "*.ogg": "external",
    "*.vue": "vue",
    "*.wav": "external",
    "*.wiki": "markdown",
    "*.wpy": "vue",
    "*.wxml": "html",
    "*.wxss": "css",
    "*.hocr": "html",
    "__bit_reference": "cpp",
    "__locale": "cpp",
    "__split_buffer": "cpp",
    "__verbose_abort": "cpp",
    "array": "cpp",
    "bitset": "cpp",
    "cctype": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "cstddef": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "cstring": "cpp",
    "ctime": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "execution": "cpp",
    "memory": "cpp",
    "fstream": "cpp",
    "initializer_list": "cpp",
    "iomanip": "cpp",
    "ios": "cpp",
    "iosfwd": "cpp",
    "iostream": "cpp",
    "istream": "cpp",
    "limits": "cpp",
    "locale": "cpp",
    "mutex": "cpp",
    "new": "cpp",
    "print": "cpp",
    "stdexcept": "cpp",
    "streambuf": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "typeinfo": "cpp",
    "vector": "cpp",
    "algorithm": "cpp",
    "map": "cpp",
    "__node_handle": "cpp",
    "__tree": "cpp",
    "optional": "cpp",
    "variant": "cpp"
  }
}
